{
  "name": "xrdspace",
  "version": "1.0.0",
  "type": "module",
  "description": "XPREP-style space-group determination and reflection merging for X-ray diffraction HKL data (JavaScript)",
  "main": "src/index.js",
  "bin": {
    "xrdspace": "src/xrdspace.js"
  },
  "scripts": {
    "test": "node tests/xrdspace-compare-10k.js --xrd",
    "test:mx": "node tests/xrdspace-mx.js",
    "test:xprep": "node tests/xrdspace-compare-10k.js --xprep --picks tests/cod-picks-10k-500.json",
    "test:cell": "node tests/xrdspace-cellsearch.js",
    "test:ins": "node tests/xrdspace-ins.js",
    "test:pdb": "node tests/xrdspace-pdbvalid.js",
    "test:mtz": "node tests/xrdspace-mtz.js",
    "test:rad": "node tests/xrdspace-rad.js",
    "build:pdb": "node scripts/build-pdb-table.js"
  },
  "keywords": [
    "crystallography",
    "space-group",
    "xrd",
    "xds",
    "shelx",
    "hkl",
    "diffraction",
    "pointless",
    "xprep"
  ],
  "author": "Denis Spasyuk",
  "license": "MIT"
}
